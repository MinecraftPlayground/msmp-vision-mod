{
  "schemaVersion": 1,
  "id": "msmp-vision-mod",
  "version": "${version}",
  "name": "MSMP Vision",
  "description": "Extends the Minecraft Server Management Protocol (MSMP) by providing additional functions for taking and rendering screenshots entirely on the server-side.",
  "authors": [],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "dev.loat.msmp_vision.MSMPVision"
    ]
  },
  "mixins": [
    "msmp_vision.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "^${minecraft_version}",
    "msmp-lib": "*",
    "config-lib": "*"
  },
  "custom": {
    "mc-publish": {
      "modrinth": {
        "project_id": "---",
        "loaders": [
          "fabric"
        ]
      }
    }
  }
}
